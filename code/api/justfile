# Go backend (net/http). Run from the repo root as `just api <recipe>`.

set fallback

[private]
default:
    @just --list

# Download dependencies
sync:
    go mod download

# Run the server (:8000)
run:
    go run ./cmd/api

# Run tests
test:
    go test ./...

# Lint and vet code
lint:
    go vet ./...
    golangci-lint run

# Format code
fmt:
    gofmt -w .
